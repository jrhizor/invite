# Supply-chain security — https://pnpm.io/supply-chain-security
# Kept here (not pnpm-workspace.yaml) so Vercel's pnpm 9 doesn't fail on a
# workspace file that lacks a `packages:` field. pnpm 9 ignores unknown keys;
# pnpm 10 (used locally) honors them. Build-script allowlist lives in
# package.json -> pnpm.onlyBuiltDependencies (empty = none trusted).
minimum-release-age=1440
verify-deps-before-run=warn
